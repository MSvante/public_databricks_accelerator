# =============================================================================
# Deploy (example: rename to .yml and add secrets to enable)
# =============================================================================
# Push to main deploys dev; prod is a manual dispatch behind a GitHub
# environment with required reviewers.
#
# Required secrets per environment: DATABRICKS_HOST_<ENV>, DATABRICKS_TOKEN_<ENV>
# (a service principal with OAuth M2M is better than a token in production)
# =============================================================================

name: Deploy

on:
  push:
    branches: [main]
    paths: ['transformation/**']
  workflow_dispatch:
    inputs:
      environment:
        description: Target to deploy
        required: true
        type: choice
        options: [dev, prod]

jobs:
  deploy:
    name: Deploy (${{ github.event.inputs.environment || 'dev' }})
    runs-on: ubuntu-latest
    environment:
      name: databricks-${{ github.event.inputs.environment || 'dev' }}
    env:
      TARGET: ${{ github.event.inputs.environment || 'dev' }}
    steps:
      - uses: actions/checkout@v4
      - uses: databricks/setup-cli@main
      - name: Validate, deploy and create schemas
        working-directory: ./transformation
        env:
          DATABRICKS_HOST: ${{ secrets[format('DATABRICKS_HOST_{0}', env.TARGET)] }}
          DATABRICKS_TOKEN: ${{ secrets[format('DATABRICKS_TOKEN_{0}', env.TARGET)] }}
        run: |
          databricks bundle validate -t "$TARGET"
          databricks bundle deploy -t "$TARGET"
          # schemas are derived from the YAML, so a new domain needs no manual step
          databricks bundle run ldp_setup -t "$TARGET"
