# =============================================================================
# Bundle validation on PRs (example: rename to .yml and add secrets to enable)
# =============================================================================
# Unit tests and lint already run in tests.yml without secrets. This adds a
# `databricks bundle validate` against a real workspace.
#
# Required secrets: DATABRICKS_HOST_DEV, DATABRICKS_TOKEN_DEV
# =============================================================================

name: Bundle validate

on:
  pull_request:
    branches: [main]
    paths: ['transformation/**']

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: databricks/setup-cli@main
      - name: Validate bundle (sandbox and dev)
        working-directory: ./transformation
        env:
          DATABRICKS_HOST: ${{ secrets.DATABRICKS_HOST_DEV }}
          DATABRICKS_TOKEN: ${{ secrets.DATABRICKS_TOKEN_DEV }}
        run: |
          databricks bundle validate -t sandbox
          databricks bundle validate -t dev
